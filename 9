import hashlib
import json
import time
from typing import List, Tuple


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def hash_string(text: str) -> str:
    return sha256_bytes(text.encode())


class MerkleTree:
    def __init__(self, leaves: List[str]):
        self.leaves = [hash_string(leaf) for leaf in leaves]
        self.levels = [self.leaves.copy()] if self.leaves else []
        self.build()

    def build(self):
        current = self.leaves.copy()

        while len(current) > 1:
            next_level = []

            for i in range(0, len(current), 2):
                left = current[i]

                if i + 1 < len(current):
                    right = current[i + 1]
                else:
                    right = left

                parent = sha256_bytes(
                    bytes.fromhex(left) + bytes.fromhex(right)
                )

                next_level.append(parent)

            current = next_level
            self.levels.append(current)

    def root(self) -> str:
        if not self.levels:
            return ""
        return self.levels[-1][0]

    def proof(self, index: int) -> List[Tuple[str, str]]:
        if not (0 <= index < len(self.leaves)):
            raise IndexError("leaf index out of range")

        proof = []
        i = index

        for level in self.levels[:-1]:
            sibling = i + 1 if i % 2 == 0 else i - 1

            if sibling >= len(level):
                sibling = i

            position = "right" if i % 2 == 0 else "left"

            proof.append((level[sibling], position))
            i //= 2

        return proof

    @staticmethod
    def verify(
        leaf: str,
        proof: List[Tuple[str, str]],
        root: str
    ) -> bool:
        current = hash_string(leaf)

        for sibling, position in proof:
            if position == "right":
                current = sha256_bytes(
                    bytes.fromhex(current)
                    + bytes.fromhex(sibling)
                )
            else:
                current = sha256_bytes(
                    bytes.fromhex(sibling)
                    + bytes.fromhex(current)
                )

        return current == root


class Block:
    def __init__(
        self,
        index: int,
        transactions: List[str],
        previous_hash: str,
        difficulty: int = 2
    ):
        self.index = index
        self.transactions = transactions[:]
        self.previous_hash = previous_hash
        self.difficulty = difficulty
        self.timestamp = time.time()
        self.nonce = 0
        self.merkle_root = MerkleTree(self.transactions).root()
        self.hash = ""
        self.mine()

    def calculate_hash(self) -> str:
        block_data = {
            "index": self.index,
            "timestamp": self.timestamp,
            "previous_hash": self.previous_hash,
            "nonce": self.nonce,
            "merkle_root": self.merkle_root,
            "transaction_count": len(self.transactions),
        }

        encoded = json.dumps(
            block_data,
            sort_keys=True
        ).encode()

        return sha256_bytes(encoded)

    def mine(self):
        target = "0" * self.difficulty

        while True:
            self.hash = self.calculate_hash()

            if self.hash.startswith(target):
                break

            self.nonce += 1


class Blockchain:
    def __init__(self, difficulty: int = 2):
        self.difficulty = difficulty
        self.chain: List[Block] = []

        genesis = Block(
            0,
            ["genesis"],
            "0" * 64,
            difficulty
        )

        self.chain.append(genesis)

    def add_block(self, transactions: List[str]) -> Block:
        block = Block(
            len(self.chain),
            transactions,
            self.chain[-1].hash,
            self.difficulty
        )

        self.chain.append(block)
        return block

    def is_valid(self) -> bool:
        for i in range(1, len(self.chain)):
            current = self.chain[i]
            previous = self.chain[i - 1]

            if current.previous_hash != previous.hash:
                return False

            if not current.hash.startswith(
                "0" * current.difficulty
            ):
                return False

            if (
                MerkleTree(current.transactions).root()
                != current.merkle_root
            ):
                return False

            if current.calculate_hash() != current.hash:
                return False

        return True


if __name__ == "__main__":
    blockchain = Blockchain(difficulty=3)

    block1 = blockchain.add_block([
        "Alice->Bob:5",
        "Carol->Dave:2",
